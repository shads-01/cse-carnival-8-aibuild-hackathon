# Copy this file to .env AT THE REPO ROOT and fill in your values.
# The server workspace (server/) loads its config from the repo-root .env via
# server/src/config/index.ts. Never commit your actual .env file.

# --- Server (server/) ---
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
JWT_SECRET=your_jwt_secret_here

# LLM API Keys — Google Gemini (Google GenAI SDK), comma-separated for rotation.
# Used by server/src/agent/llmClient.ts — when one key hits a 429 rate limit,
# the client automatically retries with the next key in this list. Add as
# many as you have; the list can be any length (2, 3, 5, ...).
GEMINI_API_KEYS=your_first_key_here,your_second_key_here,your_third_key_here

# Supabase — backend-only access. SERVICE_ROLE_KEY must never reach the client bundle.
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_ANON_KEY=your_supabase_anon_key

# --- Client (client/), Vite-prefixed so they're exposed to the browser bundle ---
# Only ever put the anon key here — never SUPABASE_SERVICE_ROLE_KEY or GEMINI_API_KEY.
VITE_API_BASE_URL=http://localhost:5000/api/v1
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
