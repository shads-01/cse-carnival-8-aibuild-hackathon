# Copy this file to .env AT THE REPO ROOT (not backend/.env) and fill in your values.
# The backend loads its config from the repo-root .env.
# Never commit your actual .env file

# LLM API Key — Google Gemini (from Google AI Studio), used by backend/src/agent/llmClient.ts
GEMINI_API_KEY=your_key_here

# Supabase (backend-only access — service-role key must never reach the frontend bundle)
SUPABASE_URL=your_supabase_project_url_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

PORT=3000
